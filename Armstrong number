
#include <iostream>
using namespace std;

int main() {
    int n, original, digit, sum = 0, count = 0;

    cout << "Enter a number: ";
    cin >> n;

    if (n < 0) {
        cout << n << " is not an Armstrong Number";
        return 0;
    }

    original = n;
    int temp = n;

    // Count the number of digits
    do {
        count++;
        temp /= 10;
    } while (temp != 0);

    temp = n;

    // Calculate the sum of digits raised to count
    do {
        digit = temp % 10;

        int power = 1;
        for (int i = 0; i < count; i++) {
            power *= digit;
        }

        sum += power;
        temp /= 10;
    } while (temp != 0);

    if (sum == original) {
        cout << original << " is an Armstrong Number";
    } else {
        cout << original << " is not an Armstrong Number";
    }

    return 0;
}
